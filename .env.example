# 独立测试及东巴 Agent 使用 python-dotenv 读取根目录 .env。
# 游戏配置仍使用环境变量或 .streamlit/secrets.toml。
# 已部署游戏的 HTTP(S) URL；非空时优先于本机导出目录。
GODOT_WEB_URL=
# 可选本机 Web 导出目录；未设置时使用 D:/livingnaxi-web2，空值禁用本机服务。
GODOT_WEB_DIR=
# 东巴视觉 Agent 与独立连通性测试使用；不填写真实 Key 到本示例。
OPENAI_API_KEY=
# true：启用真实 AI；Qwen 失败报错，旧 OpenAI 路线失败回退明确标记的 Mock。
# false/未设置：东巴只用 Mock，音乐编排使用明确标记的本地规则。
USE_REAL_AI=false
# 必须支持图片和结构化 JSON；空值默认 gpt-6-luna。
DONGBA_VISION_MODEL=
# 以下为未来音乐、视频服务预留。
MUSIC_API_KEY=
# Music planning uses existing OPENAI_API_KEY and USE_REAL_AI; no audio upload.
MUSIC_MODEL=
# Real numbered-score vision model; no Mock OMR fallback.
MUSIC_OMR_MODEL=
# Optional absolute path to Audiveris.exe; automatically searches the user tools directory.
AUDIVERIS_EXE=
DANCE_API_KEY=
# Optional Beijing native video API root (/api/v1). If blank, derived from DASHSCOPE_BASE_URL.
DANCE_API_BASE_URL=
# Milestone 4B: default provider is qwen; set openai to retain the older route.
AI_PROVIDER=qwen
# Beijing Bailian configuration. Never place real secrets in this example.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
# Copy exact enabled model IDs from your console; no default model is assumed.
# Both must support non-thinking JSON mode; vision must also support images.
QWEN_TEXT_MODEL=
QWEN_VISION_MODEL=

# Milestone 8: Web account/session deployment. These are process settings, not keys.
# Production requires exact HTTPS frontend origins, backend Host names and persistent storage.
# Website backend accepts only ordinary pay-as-you-go Bailian keys; never use a Token Plan sk-sp- key.
NAXI_API_ENV=development
NAXI_WEB_ALLOWED_ORIGINS=
NAXI_API_ALLOWED_HOSTS=
NAXI_DATA_DIR=
NAXI_API_BIND=
# Use None only for HTTPS cross-site frontend/backend origins; CSRF remains required.
NAXI_COOKIE_SAMESITE=Lax
# Frontend build-time API origin, for example an authorized HTTPS backend; blank uses same-origin /api proxy.
VITE_API_BASE_URL=
